<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>CS8632</NoWarn>
    <RootNamespace>FortnitePirateTokenTracker.App</RootNamespace>
    <AssemblyName>TokenTracker</AssemblyName>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FortniteReplayReader" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FortnitePirateTokenTracker.Core\FortnitePirateTokenTracker.Core.csproj" />
    <ProjectReference Include="..\FortnitePirateTokenTracker.ReplayReader\FortnitePirateTokenTracker.ReplayReader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
