<Project Sdk="Microsoft.NET.Sdk">

  <!--
    El constructor de Unreal.Core.NetFieldParser registra los [NetFieldExportGroup]
    de los ensamblados cuyo nombre contiene "ReplayReader". Por eso este proyecto
    se llama así: es la forma de registrar grupos propios sin parchear el parser.

    FortniteReplayReader se toma de vendor/FortniteReplayDecompressor (copia local
    con los parches de lectura de premios y de cofres del nivel), no del paquete.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>FortnitePirateTokenTracker.ReplayReader</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\FortniteReplayDecompressor\FortniteReplayReader\FortniteReplayReader.csproj" />
  </ItemGroup>

</Project>
